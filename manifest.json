{
  "manifest_version": 3,
  "name": "Mark — Web Highlighter",
  "version": "1.1.0",
  "description": "Highlight anything on the web. No account. No setup. Highlights stay when you come back.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "sidePanel", "tabs", "contextMenus"],
  "host_permissions": ["<all_urls>", "https://api.notion.com/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content/youtube-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "panel/side-panel.html"
  },
  "web_accessible_resources": [],
  "action": {
    "default_title": "Mark — Web Highlighter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
